// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Model definitions
model Report {
  // Database columns
  orgName String
  date    String

  //// Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([orgName, date]) // Composite primary key
}

model Module {
  // Mirrors the `Module` table in the oc4d-server Postgres DB.
  id           String     @id @default(uuid())
  name         String     @unique
  description  String
  indexHtmlUrl String     @map("index_html_url")
  logoUrl      String     @map("logo_url")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  language     String
  enabled      Boolean    @default(true)
  open         Boolean    @default(true)
  categories   Category[]
}

model Category {
  // Mirrors the `Category` table in the oc4d-server Postgres DB.
  // NOTE: oc4d-server's Category has no `description` column — do not add one here.
  id        String   @id @default(uuid())
  name      String   @unique
  logoUrl   String   @map("logo_url")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  modules   Module[]
}

model TrainingVideos {
  // Database columns
  id          String   @id
  title       String
  description String
  videoUrl    String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  language    String
  instructors String[]
}

/// Application users (Prisma Studio: id, name, email).
/// Log identity is matched to `email` (case-insensitive); UI shows `name` only.
/// In oc4d-server's DB the column is `full_name`; we expose it as `name` in code.
model User {
  id    String @id
  name  String @map("full_name")
  email String @unique

  @@map("User")
}
