# Database connection for your existing Docker PostgreSQL
# Must include the `User` table (id, name, email). Change @@map in prisma/schema.prisma if the table is `users`, etc.
DATABASE_URL="postgresql://postgres:postgres@localhost:5050/oc4d"
DIRECT_URL="postgresql://postgres:postgres@localhost:5050/oc4d"

# For development
NODE_ENV="development"
